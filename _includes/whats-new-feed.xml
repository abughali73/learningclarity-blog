{%- assign t = site.data.i18n[include.lang] -%}
{%- assign updates = site.posts | where: "lang", include.lang | where: "feature_update", true -%}
{%- assign home = "/" -%}{%- for l in site.languages -%}{%- if l.code == include.lang -%}{%- assign home = l.home -%}{%- endif -%}{%- endfor -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ include.lang }}">
  <title>{{ t.whats_new_title | xml_escape }} · Learning Clarity</title>
  <subtitle>{{ t.whats_new_intro | xml_escape }}</subtitle>
  <id>{{ home | append: "whats-new/" | absolute_url }}</id>
  <link href="{{ '/feed/whats-new/' | append: include.lang | append: '.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ home | append: 'whats-new/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{% if updates.size > 0 %}{{ updates.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {%- for p in updates limit: 20 %}
  <entry>
    <title>{{ p.title | xml_escape }}</title>
    <link href="{{ p.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ p.url | absolute_url }}</id>
    <published>{{ p.date | date_to_xmlschema }}</published>
    <updated>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</updated>
    <summary>{{ p.description | xml_escape }}</summary>
    {%- for f in p.features %}
    <category term="{{ f.id }}" label="{{ f.title | xml_escape }}"/>
    {%- endfor %}
  </entry>
  {%- endfor %}
</feed>
